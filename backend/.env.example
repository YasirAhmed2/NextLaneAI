# ==========================================
# NextLane AI Backend — Environment Configuration
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ==========================================

# ── Google Gemini AI (Required) ───────────────────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Gemini Model Selection
# Recommended: gemini-2.5-flash (latest), gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# ── FastAPI Server ────────────────────────────────────────────────────────────
PORT=8000
HOST="0.0.0.0"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a secure random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="your-strong-jwt-secret-here-min-32-chars"

# ── Email Alerts (Optional but Recommended) ───────────────────────────────────
# Used for sending proactive deadline alerts and weekly digests.
# For Gmail: enable 2FA, then create an App Password at:
#   https://myaccount.google.com/apppasswords
EMAIL_USER="your-gmail-address@gmail.com"
EMAIL_PASS="your-gmail-app-password-here"

# Frontend URL for email CTA links
DASHBOARD_URL="http://localhost:5000"

# ── Brevo / SendinBlue (Alternative email provider — optional) ────────────────
BREVO_API_KEY="your-brevo-api-key-here"

# ── Google Cloud / Firestore (Optional — enables real Firestore persistence) ───
# 1. Create a GCP project: https://console.cloud.google.com/
# 2. Enable Firestore: https://console.cloud.google.com/firestore
# 3. Create a Service Account with Firestore Editor role
# 4. Download JSON key and set path below
GOOGLE_APPLICATION_CREDENTIALS="path/to/your-service-account-key.json"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# ── Environment & CORS ────────────────────────────────────────────────────────
ENVIRONMENT="development"
ALLOWED_ORIGINS="http://localhost:5000,http://localhost:3000,http://127.0.0.1:5000"
