# ==========================================
# NextLane / Opportra Frontend Environment Configuration
# ==========================================

# Port for the Express server + Vite Dev Gateway
PORT=5000

# Backend FastAPI URL (Used by Express server proxy to forward AI agent requests)
OPPORTRA_BACKEND_URL="http://localhost:8000"

# Optional: Direct Gemini API key if running client-side AI experiments
GEMINI_API_KEY="AIzaSyDummyKey_ReplaceWithYourActualGeminiApiKey"

# Public App URL for production deployment
APP_URL="http://localhost:5000"
